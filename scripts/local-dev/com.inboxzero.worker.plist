<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.inboxzero.worker</string>

  <!-- BullMQ worker. It doesn't read .env, so pull the key from apps/web/.env at start instead of copying the secret here. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>export INTERNAL_API_KEY=$(grep '^INTERNAL_API_KEY=' apps/web/.env | cut -d= -f2); exec pnpm --filter @inboxzero/worker start</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/abarnett/Dev/inbox-zero</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/abarnett/.nvm/versions/node/v24.16.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>REDIS_URL</key>
    <string>redis://localhost:6380</string>
    <key>INTERNAL_API_URL</key>
    <string>http://localhost:3000</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>/Users/abarnett/Library/Logs/inbox-zero-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/abarnett/Library/Logs/inbox-zero-worker.log</string>
</dict>
</plist>
